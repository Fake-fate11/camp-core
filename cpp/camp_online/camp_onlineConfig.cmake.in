@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json)
include("${CMAKE_CURRENT_LIST_DIR}/camp_onlineTargets.cmake")

if("lanelet_context" IN_LIST camp_online_FIND_COMPONENTS)
  set(camp_online_lanelet_context_FOUND FALSE)
  if(@CAMP_AUTOWARE_MAP_BRIDGE@)
    set(_camp_lanelet_dependencies "@CAMP_LANELET_DEPENDENCIES@")
    foreach(_camp_dependency IN LISTS _camp_lanelet_dependencies)
      find_dependency(${_camp_dependency})
    endforeach()
    unset(_camp_dependency)
    unset(_camp_lanelet_dependencies)
    include("${CMAKE_CURRENT_LIST_DIR}/camp_lanelet_contextTargets.cmake")
    set(camp_online_lanelet_context_FOUND TRUE)
  endif()
endif()
check_required_components(camp_online)
